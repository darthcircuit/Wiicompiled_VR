    <string name="section_vr_headset">Headset</string>
    <string name="vr_render_scale">Headset render scale</string>
    <string name="vr_render_scale_helper">Scales the eye resolution the headset recommends. Higher is sharper and costs GPU time; lower it if races stutter.</string>
    <string name="vr_interpolation">VR frame interpolation</string>
    <string name="vr_interpolation_helper">Experimental. Renders extra frames between game frames at the headset\'s rate. Needs GPU headroom and adds one game frame of latency.</string>
    <string name="vr_interpolation_off">Off</string>
    <string name="vr_interpolation_auto">Auto</string>

