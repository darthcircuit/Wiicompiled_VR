    <string name="vr_hud_screen">Race HUD on the virtual screen</string>
    <string name="vr_hud_screen_helper">Puts the minimap, position and item roulette on a screen in front of you instead of stretching them across the view.</string>
    <string name="vr_hud_distance">Screen distance</string>
    <string name="vr_hud_distance_helper">How far the menu screen and race HUD sit in front of you.</string>
    <string name="vr_hud_width">Screen width</string>
