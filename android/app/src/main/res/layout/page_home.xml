<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingEnd="24dp">

    <TextView
        style="@style/Launcher.PageTitle"
        android:layout_width="wrap_content"
        android:layout_height="64dp"
        android:gravity="bottom"
        android:paddingBottom="10dp"
        android:text="@string/launcher_nav_home" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/neutral_700" />

    <LinearLayout
        android:id="@+id/home_data_banner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_banner_warning"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingTop="10dp"
        android:paddingEnd="14dp"
        android:paddingBottom="10dp"
        android:visibility="gone">

        <ImageView
            android:id="@+id/home_data_banner_icon"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_warning"
            android:tint="@color/warning_500" />

        <TextView
            android:id="@+id/home_data_banner_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:textColor="@color/neutral_200"
            android:textIsSelectable="true"
            android:textSize="13sp" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginStart="-24dp"
        android:layout_marginEnd="-24dp"
        android:layout_weight="1"
        android:clipChildren="true">

        <org.wiicompiled.quest.launcher.WheelTrailsView
            android:id="@+id/home_trails"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <LinearLayout
            android:layout_width="250dp"
            android:layout_height="match_parent"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="28dp"
            android:background="@drawable/bg_home_card"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="10dp"
            android:paddingEnd="10dp">

            <ImageView
                android:layout_width="200dp"
                android:layout_height="200dp"
                android:layout_marginTop="25dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_wheel"
                android:tint="@color/neutral_600" />

            <Space
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/home_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:textColor="@color/neutral_300"
                android:textSize="24sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center"
                android:text="@string/home_backend"
                android:textColor="@color/neutral_400"
                android:textSize="15sp" />

            <LinearLayout
                android:id="@+id/home_play"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_marginTop="22dp"
                android:background="@drawable/bg_play_button"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:minWidth="190dp"
                android:orientation="horizontal"
                android:paddingStart="20dp"
                android:paddingEnd="24dp">

                <ImageView
                    android:id="@+id/home_play_icon"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:duplicateParentState="true"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_play"
                    android:tint="@color/play_button_content" />

                <TextView
                    android:id="@+id/home_play_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:duplicateParentState="true"
                    android:fontFamily="sans-serif-medium"
                    android:text="@string/home_play"
                    android:textColor="@color/play_button_content"
                    android:textSize="17sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/home_secondary"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_button_secondary"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:minWidth="190dp"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:textColor="@color/neutral_100"
                android:textSize="15sp"
                android:visibility="gone" />

            <ProgressBar
                android:id="@+id/home_progress"
                style="@android:style/Widget.Material.ProgressBar.Horizontal"
                android:layout_width="190dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:max="1000"
                android:progressBackgroundTint="@color/neutral_700"
                android:progressTint="@color/primary_400"
                android:visibility="gone" />

            <TextView
                android:id="@+id/home_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:minLines="2"
                android:textColor="@color/neutral_400"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/home_cancel"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:background="@drawable/bg_nav_item"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:text="@string/home_cancel"
                android:textColor="@color/neutral_200"
                android:textSize="14sp"
                android:visibility="gone" />

            <Space
                android:layout_width="match_parent"
                android:layout_height="40dp" />
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
